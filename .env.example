# =========================================================================
# 社区团购系统 - 容器部署环境变量配置文件模板
# =========================================================================
# 使用方法：
# 1. 复制本文件并重命名为 .env
# 2. 根据您的实际大模型服务商信息，填写下方对应的参数值
# 3. 运行 docker-compose up -d 启动时，容器会自动加载并注入这些环境变量
# =========================================================================

# 智能导购客服大模型配置
# 真实 API 密钥（例如：sk-xxxxxxxxxxxxxx）
OPENAI_API_KEY=your_openai_api_key_here

# 大模型接口基地址（若使用官方接口通常为 https://api.openai.com/v1，若使用国内代理或其它中转服务请填入对应基地址）
OPENAI_BASE_URL=https://api.openai.com/v1

# 指定使用的大模型名称（例如：gpt-4o-mini、MiniMax-M2.7-highspeed 等）
OPENAI_MODEL_NAME=gpt-4o-mini

# MiMo 语音大模型配置（可选，如不填写或无效，客服系统将自动降级为浏览器原生语音播报）
MIMO_API_KEY=
MIMO_BASE_URL=
MIMO_MODEL=mimo-v2.5-tts
MIMO_VOICE=冰糖
